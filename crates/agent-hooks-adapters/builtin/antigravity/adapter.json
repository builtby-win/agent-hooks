{
  "id": "antigravity",
  "display_name": "Google Antigravity",
  "aliases": ["google-antigravity", "antigravity-cli"],
  "default_version": "v1",
  "detect": {
    "harness_hint": ["antigravity"],
    "payload_keys_any": [["conversationId", "workspacePaths"], ["toolCall"]],
    "event_names": ["SessionStart", "PreInvocation", "PostInvocation", "PreToolUse", "PostToolUse", "Stop"]
  },
  "versions": {
    "v1": {
      "agent_cli": {
        "executables": ["agy"],
        "recipe_source": "resume: https://github.com/herdrdev/herdr/blob/master/src/agent_resume.rs#L197-L285; start, exec, models, model_args: agy --help; agy models (CLI help, checked against installed versions)",
        "resume": {"argv": ["agy", "--conversation", "{session_ref}"], "session_ref": "id"},
        "start": {"argv": ["agy", "--prompt-interactive", "{prompt}"]},
        "exec": {"argv": ["agy", "--print", "{prompt}"]},
        "models": {"argv": ["agy", "models"]},
        "model_args": ["--model", "{model}"],
        "yolo_args": ["--dangerously-skip-permissions"]
      },
      "verified_against": "1.4.2",
      "install": [
        {
          "op": "json_hooks",
          "paths": ["~/.gemini/config/hooks.json", ".agents/hooks.json"],
          "create": true,
          "root": "{name}.{event}",
          "entry_shape": "named",
          "name": "agent-hooks",
          "entry": {
            "type": "command",
            "command": "agent-hooks hook antigravity --event {event}",
            "timeout": 30
          },
          "dedupe": "command_subset"
        }
      ],
      "events": {
        "SessionStart": {"lifecycle": "SessionStart", "capability": "observe", "entry_shape": "flat"},
        "PreInvocation": {"lifecycle": "PreLLMCall", "capability": "observe", "entry_shape": "flat"},
        "PostInvocation": {"lifecycle": "PostLLMCall", "capability": "observe", "entry_shape": "flat"},
        "PreToolUse": {"lifecycle": "PreToolUse", "capability": "gate", "verdicts": ["allow", "deny", "ask"]},
        "PostToolUse": {"lifecycle": "PostToolUse", "capability": "observe"},
        "Stop": {"lifecycle": "Stop", "capability": "continue", "demote_when": {"fullyIdle": false}, "entry_shape": "flat"}
      },
      "extraction_overrides": {
        "PreInvocation": {
          "flavor_text": [
            "prompt",
            "user_prompt",
            "userPrompt",
            "message",
            "content"
          ]
        },
        "PreToolUse": {
          "flavor_text": [
            "description"
          ]
        },
        "PostToolUse": {
          "flavor_text": [
            "tool_output",
            "toolOutput",
            "output",
            "result",
            "content"
          ]
        },
        "Stop": {
          "flavor_text": [
            "error",
            "summary",
            "message",
            "result"
          ]
        }
      },
      "extraction": {
        "session_id": ["conversationId", "conversation_id", "sessionId", "session_id"],
        "parent_session_id": ["parent_session_id", "parentSessionId", "parentSessionID", "parent_id", "parentId", "parentID", "parent_session_hash", "parentSessionHash", "session.parent_id", "session.parent_session_id", "session.parentSessionId", "session.parent_session_hash", "properties.session.parent_id", "properties.session.parent_session_id"],
        "cwd": ["workspacePaths", "toolCall.args.Cwd", "cwd", "workspace_path"],
        "prompt": ["prompt", "user_prompt", "userPrompt", "message", "input", "content", {"transcript": "latest_prompt"}],
        "tool_name": ["toolCall.name", "tool_name"],
        "tool_input": ["toolCall.args", "tool_input"],
        "tool_output": ["tool_output", "toolOutput", "output", "result", "content"],
        "error": ["error", "error_message"],
        "success": ["success", "fullyIdle"],
        "summary": ["error", "summary", "message", "result", {"transcript": "latest_assistant"}, "terminationReason", "termination_reason", "reason"]
      },
      "response": {
        "mode": "json",
        "gate": {
          "allow": {"decision": "allow"},
          "deny": {"decision": "deny", "reason": "{reason?}"},
          "ask": {"decision": "ask", "reason": "{reason?}"}
        },
        "observe": {},
        "defer_overrides": {"PreToolUse": {"decision": "allow"}},
        "continue": {
          "continue": {"decision": "continue", "reason": "{reason}"},
          "stop": {}
        }
      },
      "ignore_cwd_patterns": [".gemini"],
      "unavailable": ["SessionEnd", "PermissionRequest", "Notification", "SubagentStart", "SubagentStop"]
    }
  }
}
